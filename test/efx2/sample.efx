// View 1
// File generated from metadata database
LET text:$t='tom'; // global 1
//test
--- TEMPLATE address ---
PARAMETERS text:$street, text:$town;
DISPLAY ${$street}, ${$town}; // a callable template
--- MAIN ---
1 WHEN OPT-300-Procedure-Buyer is present DISPLAY #{auxiliary|text|buyer};  // 1 Buyer
	1 WITH ND-ContractingParty DISPLAY #{auxiliary|text|buyer}; // 1.1 Buyer
		WITH BT-11-Procedure-Buyer DISPLAY #{field|name|BT-11-Procedure-Buyer}: #{BT-11-Procedure-Buyer}; // Legal type of the buyer
		WITH ND-ContractingParty DISPLAY #{field|name|BT-500-Organization-Company}: ${for text:$orgid in OPT-300-Procedure-Buyer, text:$orgname in BT-500-Organization-Company[OPT-200-Organization-Company == $orgid] return $orgname}; // Official name
		WITH BT-10-Procedure-Buyer DISPLAY #{name}: #value; // Activity of the contracting authority
2 DISPLAY #{auxiliary|text|procedure}; // 2 Procedure
	1 WITH ND-ProcedureProcurementScope DISPLAY #{auxiliary|text|procedure}; // 2.1 Procedure
		WITH ND-ProcedureProcurementScope DISPLAY #{field|name|BT-24-Procedure}: ${preferred-language-text(BT-24-Procedure)}; // Procedure Description
		WITH ND-ProcedureProcurementScope DISPLAY #{field|name|BT-21-Procedure}: ${preferred-language-text(BT-21-Procedure)}; // Procedure Title
		WITH BT-22-Procedure DISPLAY #{field|name|BT-22-Procedure}: ${BT-22-Procedure}; // Internal identifier
		1 WITH ND-ProcedureProcurementScope[(BT-23-Procedure is present) or (BT-531-Procedure is present) or (BT-262-Procedure is present) or (BT-263-Procedure is present)] DISPLAY #{auxiliary|text|purpose}; // 2.1.1 Purpose
			WITH BT-23-Procedure DISPLAY #{field|name|BT-23-Procedure}: #{BT-23-Procedure}; // Nature of the contract
			WITH ND-ProcedureProcurementScope[BT-531-Procedure is present] DISPLAY #{field|name|BT-531-Procedure}: #{BT-531-Procedure}; // Additional nature of the contract
			WITH BT-262-Procedure[BT-26(m)-Procedure == 'cpv'] DISPLAY #{field|name|BT-262-Procedure} (${BT-26(m)-Procedure}): ${BT-262-Procedure} #{BT-262-Procedure}; // Main classification (CPV)
			// Not used anymore
			WITH BT-263-Procedure[BT-26(a)-Procedure == 'cpv'] DISPLAY #{field|name|BT-263-Procedure} (${BT-26(a)-Procedure}): ${BT-263-Procedure} #{BT-263-Procedure}; // Additional classification (CPV)
			// Not used anymore
		? WITH ND-ProcedurePlacePerformance DISPLAY #{auxiliary|text|place-performance}; // 2.1.2 Place of performance
			WITH BT-5101(a)-Procedure DISPLAY #{field|name|BT-5101(a)-Procedure}: ${BT-5101(a)-Procedure} ${BT-5101(b)-Procedure} ${BT-5101(c)-Procedure}; // Place Performance Postal address
			WITH ND-ProcedurePlacePerformance INVOKE address(BT-5101(a)-Procedure, BT-5131-Procedure); // Place Performance address
			WITH BT-5131-Procedure DISPLAY #{field|name|BT-5131-Procedure}: ${BT-5131-Procedure}; // Place Performance Town
			WITH BT-5121-Procedure DISPLAY #{field|name|BT-5121-Procedure}: ${BT-5121-Procedure}; // Place Performance Post Code
			WITH BT-5071-Procedure DISPLAY #{field|name|BT-5071-Procedure}: #{BT-5071-Procedure} (${BT-5071-Procedure}); // Place Performance Country Subdivision
			WITH BT-5141-Procedure DISPLAY #{field|name|BT-5141-Procedure}: #{BT-5141-Procedure}; // Place Performance Country
			WITH BT-727-Procedure DISPLAY #{BT-727-Procedure}; // Place Performance Services Other
			WITH ND-ProcedurePlacePerformance[BT-728-Procedure is present] DISPLAY #{field|name|BT-728-Procedure}: ${preferred-language-text(BT-728-Procedure)}; // Place Performance Additional information
		4 WITH ND-ProcedureProcurementScope[BT-01-notice is present] DISPLAY #{auxiliary|text|general-information}; // 2.1.4 General information
			WITH ND-ProcedureProcurementScope[BT-300-Procedure is present] DISPLAY #{field|name|BT-300-Procedure}: ${preferred-language-text(BT-300-Procedure)}; // Additional information
			WITH ND-ProcedureProcurementScope DISPLAY #{auxiliary|text|legal-basis}:; // Legal basis
			WITH BT-01-notice DISPLAY #{BT-01-notice}; // Procedure Legal Basis
			WITH BT-01(c)-Procedure DISPLAY ${BT-01(c)-Procedure} - ${preferred-language-text(BT-01(d)-Procedure)}; // Procedure Legal Basis (ID) - Procedure Legal Basis (Description)
			WITH BT-01(e)-Procedure DISPLAY ${preferred-language-text(BT-01(f)-Procedure)}; // Procedure Legal Basis (no ID) Description
8 DISPLAY #{auxiliary|text|organisations}; // 8 Organisations
	1 WITH  context:$ctx = ND-Organization, 
	        text:$orgid=OPT-200-Organization-Company, 
	        text:$tpoid=OPT-201-Organization-TouchPoint, 
	        text:$testlist=BT-137-Lot[BT-137-Lot != ''], 
	        text:$lotswon = string-join(for text:$tpaid in OPT-210-Tenderer[OPT-300-Tenderer == $orgid], 
	        text:$tenderid in OPT-321-Tender[OPT-310-Tender == $tpaid], 
	        text:$contractid in OPT-315-LotResult[BT-3202-Contract == $tenderid], 
	        text:$lrid in OPT-322-LotResult[OPT-320-LotResult[OPT-315-LotResult == $contractid] == $tenderid], 
	        text:$lotid in BT-13713-LotResult[OPT-322-LotResult == $lrid] return $lotid, ';')
	DISPLAY ${OPT-200-Organization-Company}; // 8.1 Organisation Technical Identifier
		WITH ND-Organization DISPLAY #{field|name|BT-500-Organization-Company}: ${$testlist}  ${BT-500-Organization-Company}; // Organisation Name
		WITH BT-501-Organization-Company DISPLAY #{field|name|BT-501-Organization-Company}: ${BT-501-Organization-Company}; // Organization Identifier
		WITH BT-16-Organization-Company DISPLAY #{field|name|BT-16-Organization-Company}: ${BT-16-Organization-Company}; // Organization Part Name
		WITH BT-510(a)-Organization-Company DISPLAY #{field|name|BT-510(a)-Organization-Company}: ${BT-510(a)-Organization-Company} ${BT-510(b)-Organization-Company} ${BT-510(c)-Organization-Company}; // Postal address
		WITH BT-513-Organization-Company DISPLAY #{field|name|BT-513-Organization-Company}: ${BT-513-Organization-Company}; // Organization City
		WITH BT-512-Organization-Company DISPLAY #{field|name|BT-512-Organization-Company}: ${BT-512-Organization-Company}; // Organization Post Code
		WITH BT-507-Organization-Company DISPLAY #{field|name|BT-507-Organization-Company}: #{BT-507-Organization-Company} (${BT-507-Organization-Company}); // Organization Country Subdivision
		WITH BT-514-Organization-Company DISPLAY #{field|name|BT-514-Organization-Company}: #{BT-514-Organization-Company}; // Organization Country
		WITH BT-502-Organization-Company DISPLAY #{field|name|BT-502-Organization-Company}: ${BT-502-Organization-Company}; // Organization Contact Point
		WITH BT-506-Organization-Company DISPLAY #{field|name|BT-506-Organization-Company}: ${BT-506-Organization-Company}; // Organization Contact Email Address
		WITH BT-503-Organization-Company DISPLAY #{field|name|BT-503-Organization-Company}: ${BT-503-Organization-Company}; // Organization Contact Telephone Number
		WITH BT-739-Organization-Company DISPLAY #{field|name|BT-739-Organization-Company}: ${BT-739-Organization-Company}; // Organization Contact Fax
		WITH BT-505-Organization-Company DISPLAY #{field|name|BT-505-Organization-Company}: ${BT-505-Organization-Company}; // Organization Internet Address
		WITH BT-509-Organization-Company DISPLAY #{field|name|BT-509-Organization-Company}: ${BT-509-Organization-Company}; // Organization eDelivery Gateway
		WITH BT-508-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid] DISPLAY #{field|name|BT-508-Procedure-Buyer}: ${BT-508-Procedure-Buyer}; // Buyer Profile URL
		# WITH ND-Touchpoint DISPLAY #{auxiliary|text|other-contact-point}:; // TouchPoint / Other contact points
			WITH ND-Touchpoint[BT-500-Organization-TouchPoint is present] DISPLAY #{field|name|BT-500-Organization-TouchPoint}: ${BT-500-Organization-TouchPoint}; // Buyer Touchpoint Name
			WITH BT-16-Organization-TouchPoint DISPLAY #{field|name|BT-16-Organization-TouchPoint}: ${BT-16-Organization-TouchPoint}; // Touchpoint Part Name
			WITH BT-510(a)-Organization-TouchPoint DISPLAY #{field|name|BT-510(a)-Organization-TouchPoint}: ${BT-510(a)-Organization-TouchPoint} ${BT-510(b)-Organization-TouchPoint} ${BT-510(c)-Organization-TouchPoint}; // Touchpoint Postal Address
			WITH BT-513-Organization-TouchPoint DISPLAY #{field|name|BT-513-Organization-TouchPoint}: ${BT-513-Organization-TouchPoint}; // Touchpoint City
			WITH BT-512-Organization-TouchPoint DISPLAY #{field|name|BT-512-Organization-TouchPoint}: ${BT-512-Organization-TouchPoint}; // Touchpoint Post Code
			WITH BT-507-Organization-TouchPoint DISPLAY #{field|name|BT-507-Organization-TouchPoint}: #{BT-507-Organization-TouchPoint} (${BT-507-Organization-TouchPoint}); // Touchpoint Country Subdivision
			WITH BT-514-Organization-TouchPoint DISPLAY #{field|name|BT-514-Organization-TouchPoint}: #{BT-514-Organization-TouchPoint}; // Touchpoint Country
			WITH BT-502-Organization-TouchPoint DISPLAY #{field|name|BT-502-Organization-TouchPoint}: ${BT-502-Organization-TouchPoint}; // Touchpoint Contact Point
			WITH BT-506-Organization-TouchPoint DISPLAY #{field|name|BT-506-Organization-TouchPoint}: ${BT-506-Organization-TouchPoint}; // Touchpoint Contact Email Address
			WITH BT-503-Organization-TouchPoint DISPLAY #{field|name|BT-503-Organization-TouchPoint}: ${BT-503-Organization-TouchPoint}; // Touchpoint Contact Telephone Number
			WITH BT-739-Organization-TouchPoint DISPLAY #{field|name|BT-739-Organization-TouchPoint}: ${BT-739-Organization-TouchPoint}; // Touchpoint Contact Fax
			WITH BT-505-Organization-TouchPoint DISPLAY #{field|name|BT-505-Organization-TouchPoint}: ${BT-505-Organization-TouchPoint}; // Touchpoint Internet Address
			WITH BT-509-Organization-TouchPoint DISPLAY #{field|name|BT-509-Organization-TouchPoint}: ${BT-509-Organization-TouchPoint}; // Touchpoint eDelivery Gateway
		# WITH ND-Organization DISPLAY #{auxiliary|text|roles}:; // Roles of this organisation
			# WITH OPT-300-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid] DISPLAY #{auxiliary|text|buyer}; // This org is a Buyer
			WITH OPT-030-Procedure-SProvider[OPT-030-Procedure-SProvider[(OPT-300-Procedure-SProvider == $orgid) or (OPT-300-Procedure-SProvider == $tpoid)] == 'serv-prov'] DISPLAY #{auxiliary|text|organisation-providing-procurement-service}; // This org is a Service Provider
			WITH OPT-030-Procedure-SProvider[OPT-030-Procedure-SProvider[(OPT-300-Procedure-SProvider == $orgid) or (OPT-300-Procedure-SProvider == $tpoid)] == 'ted-esen'] DISPLAY #{auxiliary|text|organisation-providing-procurement-service}; // This org is an eSender
10 WITH ND-Root[BT-758-notice is present] DISPLAY #{auxiliary|text|change}; // 10 Change
	WITH BT-758-notice DISPLAY #{field|name|BT-758-notice}: ${BT-758-notice}; // Change Notice Version Identifier
	WITH BT-140-notice DISPLAY #{field|name|BT-140-notice}: #{BT-140-notice}; // Change Reason Code
	WITH ND-ChangeReason[BT-762-notice is present] DISPLAY #{field|name|BT-762-notice}: ${BT-762-notice}; // Change Reason Description
	1 WITH ND-Change DISPLAY #{auxiliary|text|change}; // 10.1 Change
		WITH BT-13716-notice DISPLAY #{field|name|BT-13716-notice}: ${BT-13716-notice}; // Change Previous Section Identifier
		WITH ND-Change[BT-141(a)-notice is present] DISPLAY #{field|name|BT-141(a)-notice}: ${BT-141(a)-notice}; // Change Description
		WITH BT-719-notice 
		DISPLAY #{field|name|BT-718-notice}: $value; // Change Procurement Documents / Change Procurement Documents Date
# DISPLAY #{auxiliary|text|notice-information}; // Notice information
	WITH BT-701-notice DISPLAY #{field|name|BT-701-notice}: ${BT-701-notice} - ${BT-757-notice}; // Notice identifier / version
	WITH BT-03-notice DISPLAY #{field|name|BT-03-notice}: #{BT-03-notice}; // Form type
	WITH BT-02-notice DISPLAY #{field|name|BT-02-notice}: #{BT-02-notice}; // Notice type
	WITH BT-05(a)-notice DISPLAY #{field|name|BT-05(a)-notice}: ${BT-05(a)-notice} ${BT-05(b)-notice}; // Notice dispatch date and time
	WITH BT-803(d)-notice DISPLAY #{field|name|BT-803(d)-notice}: ${BT-803(d)-notice} ${BT-803(t)-notice}; // Notice dispatch date (eSender)
	WITH BT-702(a)-notice DISPLAY #{field|name|BT-702(a)-notice}: #{BT-702(a)-notice} #{BT-702(b)-notice}; // Languages in which this notice is officially available
	WITH OPP-010-notice DISPLAY #{field|name|OPP-010-notice}: ${OPP-010-notice}; // Notice publication number
	WITH OPP-011-notice DISPLAY #{field|name|OPP-011-notice}: ${OPP-011-notice}; // OJ S issue number
	WITH OPP-012-notice DISPLAY #{field|name|OPP-012-notice}: ${OPP-012-notice}; // Publication date
