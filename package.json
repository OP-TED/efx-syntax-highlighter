    "@codemirror/state": "^6.2.0",
    "@codemirror/view": "^6.8.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.12"
  },
  "devDependencies": {
    "@lezer/generator": "^1.3.0",
    "antlr-ng": "1.0.10",
    "antlr4ng": "3.0.16"
  },
  "config": {
    "sdk": "OP-TED/eForms-SDK@e64ae124230cfae2f44924291e1909baada2102d",
