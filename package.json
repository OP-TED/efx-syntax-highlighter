    "sync": "node scripts/sync.js",
    "demo": "node scripts/demo.js",
    "site": "node scripts/site.js"
  },
  "keywords": [
    "efx",
    "codemirror",
    "lezer",
    "syntax-highlighting"
  ],
  "author": {
    "name": "Publications Office of the European Union",
    "email": "OP-TED-DEVOPS@publications.europa.eu"
  },
  "license": "EUPL-2.0",
